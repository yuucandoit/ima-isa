# ═══════════════════════════════════════════════════════════════
# IMA-ISA — satu file .env dipakai oleh API, web, dan worker.
# JANGAN menulis key yang sama dua kali: nilai terakhir akan menimpa.
# Worker membaca root .env ini; services/worker-ai/.env hanya perlu
# bila worker dijalankan sebagai deployment terpisah.
# ═══════════════════════════════════════════════════════════════

# ── Infrastructure (Docker Compose) ────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=media_intel
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Shared: database & Redis (API + worker) ────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/media_intel
REDIS_URL=redis://localhost:6379

# ── Shared: LLM gateway eksternal (API + worker) ───────────────
# Tidak ada model lokal / Ollama. Briefing memakai endpoint OpenAI-compatible.
# LLM_URL menerima URL penuh /chat/completions atau base /v1.
# Contoh provider: commandcode, OpenAI, Groq, OpenRouter, Together, dll.
LLM_URL=https://api.commandcode.ai/provider/v1/chat/completions
LLM_API_KEY=
# WAJIB: model ID persis dari provider (kosong = briefing pakai fallback ekstraktif)
LLM_MODEL=
# auto | openai
LLM_PROVIDER=auto
# Header auth opsional (default Bearer). Azure: LLM_AUTH_HEADER=api-key & LLM_AUTH_PREFIX=
LLM_AUTH_HEADER=Authorization
LLM_AUTH_PREFIX=Bearer
LLM_TIMEOUT_MS=60000
# Model reasoning butuh ruang token lebih besar (CoT + jawaban)
LLM_MAX_TOKENS=2000


# ── API only (apps/api) ────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Optional shared secret. When set, mutating/internal endpoints require x-api-key.
API_KEY=
# Optional: serve the built dashboard (apps/web/dist) from the API process.
WEB_DIST=
# Spike detection scanner
ALERT_SCAN_ENABLED=true
ALERT_SCAN_INTERVAL_MS=300000
ALERT_VOLUME_MULTIPLIER=2.5
ALERT_NEGATIVE_RATIO=0.65
# Alert fan-out (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ── Web only (apps/web) ────────────────────────────────────────
# Leave empty in development so Vite proxies /api to the API server.
VITE_API_URL=
# Optional: must match API_KEY if the API enforces the shared secret.
VITE_API_KEY=

# ── Worker only (services/worker-ai) ───────────────────────────
# DATABASE_URL, REDIS_URL, dan LLM_* sudah didefinisikan di blok Shared di atas.
RAW_STREAM=media:raw
CONSUMER_GROUP=ai-workers
RSS_POLL_INTERVAL_SECONDS=180
EXTRACT_FULLTEXT=true
EMBEDDING_MODEL=indobenchmark/indobert-base-p1
SENTIMENT_MODEL=mdhugol/indonesia-bert-sentiment-classification
SPACY_MODEL=id_core_news_lg
# Default ringan untuk laptop. Set true hanya bila sudah install
# requirements-ai.txt (+ model spaCy) dan mesinnya kuat.
USE_TRANSFORMERS=false
USE_SPACY=false
CLUSTER_WINDOW_HOURS=24
# 0 = auto (0.25 transformer / 0.62 lexical fallback)
CLUSTER_DISTANCE_THRESHOLD=0
CLUSTER_MIN_ITEMS=5

# ── Social media (opsional) ────────────────────────────────────
# X/Twitter API v2 recent search — butuh bearer token (tier berbayar).
# Kosong = adapter X dilewati.
X_BEARER_TOKEN=
X_QUERY=(Indonesia OR nasional) -is:retweet lang:id
# WOEID 23424846 = Indonesia; ganti untuk tren kota/negara lain.
X_TRENDS_WOEID=23424846
X_TRENDS_REGION=Indonesia
# YouTube public RSS — tidak butuh API key, cukup channel ID (pisahkan koma).
# Contoh: UCxxxxxxxx,UCyyyyyyyy
YOUTUBE_CHANNEL_IDS=

# ── Trending (X / TikTok / Google Trends) ──────────────────────
# Semua opsional — tiap platform punya jalur tanpa kredensial.
# Google Trends: sumber utama = halaman /trending (140 tren/24 jam, volume asli,
# related queries, berita). Cadangan otomatis ke RSS bila struktur berubah.
GOOGLE_TRENDS_GEO=ID
GOOGLE_TRENDS_REGION=Indonesia
# page = scrape halaman trending, rss = pakai RSS resmi (10 tren).
GOOGLE_TRENDS_SOURCE=page
# Jendela yang diambil (pisahkan koma): 4,24,48,168. Tiap jendela ±1,3 MB.
GOOGLE_TRENDS_WINDOWS=24
GOOGLE_TRENDS_TIMEOUT_SECONDS=45
# TikTok: region Creative Center + periode (hari).
TIKTOK_TRENDS_REGION=ID
TIKTOK_TRENDS_PERIOD=7
# TikTok Creative Center menolak permintaan anonim (40101).
# Tempel cookie sesi dari browser login TikTok Ads, contoh isi:
#   sessionid=abc123; sid_tt=abc123; sessionid_ss=abc123
# Kosong = fallback ke Discover feed publik (hashtag & sound, tanpa login).
TIKTOK_SESSION_COOKIE=
# X: jalur resmi (paket berbayar) atau login akun.
# Isi X_AUTH_TOKEN + X_CT0 dari cookie browser x.com (auth_token & ct0).
# Kosong = pakai guest token publik (tanpa akun, volume tren tidak tersedia).
X_AUTH_TOKEN=
X_CT0=
# auto = API resmi → cookie login → guest ; api|login|guest = paksa satu jalur.
X_TRENDS_MODE=auto
# Snapshot tren per platform (detik). Feed Google berganti tiap ±1 menit,
# jadi Google paling sering; X/TikTok cukup lebih jarang.
TRENDS_INTERVAL_GOOGLE=60
TRENDS_INTERVAL_TIKTOK=300
TRENDS_INTERVAL_X=600
# Jeda loop worker (detik) + jumlah tren per siklus.
TRENDS_POLL_INTERVAL_SECONDS=60
TRENDS_LIMIT_PER_PLATFORM=20
# Google halaman trending punya 140+ baris; simpan lebih banyak.
TRENDS_GOOGLE_LIMIT=200
