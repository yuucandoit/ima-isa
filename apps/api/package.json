{
  "name": "@media-intel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/swagger": "^1.3.1",
    "@media-intel/types": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.19",
    "ioredis": "^5.6.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
