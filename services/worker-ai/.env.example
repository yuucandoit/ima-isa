# Worker AI — salin ke `.env` bila menjalankan di luar Docker
DATABASE_URL=postgres://postgres:postgres@localhost:5432/media_intel
REDIS_URL=redis://localhost:6379

RAW_STREAM=media:raw
PROCESSED_STREAM=media:processed
DEAD_STREAM=media:dead
CONSUMER_GROUP=ai-workers
WORKER_BATCH_SIZE=6

# Ingestion
RSS_POLL_INTERVAL_SECONDS=180
RSS_MAX_ENTRIES_PER_FEED=15
EXTRACT_FULLTEXT=true
FULLTEXT_LIMIT_PER_FEED=5
DEDUPE_TTL_SECONDS=604800

# NLP — set USE_TRANSFORMERS=false / USE_SPACY=false untuk mode ringan
# Default ringan; aktifkan hanya bila requirements-ai.txt terpasang.
USE_TRANSFORMERS=false
USE_SPACY=false
SENTIMENT_MODEL=mdhugol/indonesia-bert-sentiment-classification
EMBEDDING_MODEL=indobenchmark/indobert-base-p1
SPACY_MODEL=id_core_news_lg
SENTIMENT_LABEL_MAP=LABEL_0:POSITIVE,LABEL_1:NEUTRAL,LABEL_2:NEGATIVE

# Clustering
CLUSTER_WINDOW_HOURS=24
# 0 = auto: 0.25 (transformers) / 0.62 (lexical fallback)
CLUSTER_DISTANCE_THRESHOLD=0
CLUSTER_MIN_ITEMS=5
CLUSTER_MAX_SPAN_HOURS=4
CLUSTER_INTERVAL_SECONDS=300

# LLM eksternal untuk ringkasan otomatis di cron worker (tanpa model lokal).
#   LLM_URL=https://api.commandcode.ai/provider/v1/chat/completions
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=auto
LLM_AUTH_HEADER=Authorization
LLM_AUTH_PREFIX=Bearer
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2000
GENERATE_CLUSTER_SUMMARIES=false

# Optional social adapters
X_BEARER_TOKEN=
X_QUERY=(Indonesia OR nasional) -is:retweet lang:id
# WOEID 23424846 = Indonesia
X_TRENDS_WOEID=23424846
X_TRENDS_REGION=Indonesia
YOUTUBE_CHANNEL_IDS=
